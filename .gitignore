# The shipped iPad runtime needs these shared project files in a clean checkout.
!/Device/iPadUseDevice/TatwoIPadDevice.xcodeproj/
/Device/iPadUseDevice/TatwoIPadDevice.xcodeproj/*
!/Device/iPadUseDevice/TatwoIPadDevice.xcodeproj/project.pbxproj
!/Device/iPadUseDevice/TatwoIPadDevice.xcodeproj/project.xcworkspace/
/Device/iPadUseDevice/TatwoIPadDevice.xcodeproj/project.xcworkspace/*
!/Device/iPadUseDevice/TatwoIPadDevice.xcodeproj/project.xcworkspace/contents.xcworkspacedata
!/Device/iPadUseDevice/TatwoIPadDevice.xcodeproj/xcshareddata/
/Device/iPadUseDevice/TatwoIPadDevice.xcodeproj/xcshareddata/*
!/Device/iPadUseDevice/TatwoIPadDevice.xcodeproj/xcshareddata/xcschemes/
/Device/iPadUseDevice/TatwoIPadDevice.xcodeproj/xcshareddata/xcschemes/*
!/Device/iPadUseDevice/TatwoIPadDevice.xcodeproj/xcshareddata/xcschemes/TatwoIPadDevice.xcscheme
