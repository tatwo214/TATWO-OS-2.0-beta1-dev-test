{
  "$comment": "W183 共用接口範例（主導定；接口約定 v2 §5、v3）。App（R1）與關口（R2）的測試都讀這份。值都是假的。os.sock 一行一個 JSON：{\"id\",\"method\",\"params\"} → {\"id\",\"result\"} 或 {\"id\",\"error\":{\"code\",\"message\"}}。",
  "hands_auth": {
    "register_client": {
      "params": { "op": "register_client", "redirect_uris": ["https://callback.example.com/oauth/callback"], "client_name": "ChatGPT" },
      "result": { "client_id": "hc_0123456789abcdef" },
      "errors": [
        { "when": "redirect 不在 App 設定的 callback 清單", "error": { "code": "invalid_redirect_uri", "message": "redirect_uri not allowed" } },
        { "when": "待處理 client 太多或限流", "error": { "code": "rate_limited", "message": "try later" } }
      ]
    },
    "authorize_begin": {
      "params": { "op": "authorize_begin", "client_id": "hc_0123456789abcdef", "redirect_uri": "https://callback.example.com/oauth/callback", "code_challenge": "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM", "code_challenge_method": "S256", "state": "xyz", "resource": "https://hands.example.com/mcp", "scope": "tatwo.hands" },
      "result": { "transaction_id": "tx_A7K2", "display_code": "A7K2", "expires_at": "2099-01-01T00:00:00Z" },
      "errors": [
        { "when": "App 沒開配對窗口", "error": { "code": "pairing_window_closed", "message": "open pairing in TATWO first" } },
        { "when": "已有一筆待配對", "error": { "code": "pairing_busy", "message": "another pairing is pending" } },
        { "when": "code_challenge_method 不是 S256", "error": { "code": "invalid_request", "message": "S256 required" } }
      ]
    },
    "authorize_submit": {
      "params": { "op": "authorize_submit", "transaction_id": "tx_A7K2", "pairing_code": "7K3M9QX2", "browser_binding_hash": "sha256:5f2c0c3e9d6b4a1f" },
      "result": { "authorization_code": "ac_fedcba9876543210", "redirect_uri": "https://callback.example.com/oauth/callback", "state": "xyz" },
      "errors": [
        { "when": "配對碼錯", "error": { "code": "invalid_pairing_code", "message": "wrong code", "attempts_left": 4 } },
        { "when": "窗口到期或錯滿 5 次", "error": { "code": "pairing_expired", "message": "start pairing again" } }
      ]
    },
    "token": {
      "params_authorization_code": { "op": "token", "grant_type": "authorization_code", "code": "ac_fedcba9876543210", "code_verifier": "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk", "client_id": "hc_0123456789abcdef", "redirect_uri": "https://callback.example.com/oauth/callback" },
      "params_refresh_token": { "op": "token", "grant_type": "refresh_token", "refresh_token": "rt_1111111111111111", "client_id": "hc_0123456789abcdef" },
      "result": { "access_token": "at_2222222222222222", "token_type": "Bearer", "expires_in": 3600, "refresh_token": "rt_3333333333333333", "scope": "tatwo.hands" },
      "errors": [
        { "when": "授權碼過期、已用過、PKCE 不符、redirect 不符", "error": { "code": "invalid_grant", "message": "invalid grant" } },
        { "when": "refresh 重用（舊的再被用）→ 撤銷該 grant", "error": { "code": "invalid_grant", "message": "grant revoked" } }
      ]
    },
    "check": {
      "params": { "op": "check", "access_token": "at_2222222222222222" },
      "result": { "ok": true, "grant_id": "g_4444", "client_id": "hc_0123456789abcdef", "level": 2 },
      "result_invalid": { "ok": false }
    }
  },
  "hands_tools": {
    "params": { "access_token": "at_2222222222222222" },
    "result": {
      "level": 1,
      "tools": [
        { "name": "read_file", "description": "Read a file from your workspace or an allowed project (read-only).", "inputSchema": { "type": "object", "additionalProperties": false, "properties": { "workspace_id": { "type": "string" }, "project_id": { "type": "string" }, "path": { "type": "string" }, "offset_line": { "type": "integer", "minimum": 1 }, "limit_lines": { "type": "integer", "minimum": 1, "maximum": 2000 } }, "required": ["path"] }, "annotations": { "readOnlyHint": true } },
        { "name": "memory_inbox_save", "description": "Save a note to the ChatGPT inbox in TATWO memory (not the main memory).", "inputSchema": { "type": "object", "additionalProperties": false, "properties": { "title": { "type": "string", "maxLength": 120 }, "content": { "type": "string", "maxLength": 4000 } }, "required": ["title", "content"] }, "annotations": { "readOnlyHint": false } }
      ]
    }
  },
  "hands_call": {
    "params": { "access_token": "at_2222222222222222", "name": "read_file", "arguments": { "workspace_id": "ws_5555", "path": "README.md", "offset_line": 1, "limit_lines": 50 }, "request_id": "req-0001" },
    "result": { "content": [ { "type": "text", "text": "{\"path\":\"README.md\",\"total_lines\":12,\"sha256\":\"…\",\"lines\":\"1\\t# Example\\n\"}" } ], "isError": false },
    "result_tool_error": { "content": [ { "type": "text", "text": "path is protected: .git" } ], "isError": true },
    "result_in_progress": { "content": [ { "type": "text", "text": "{\"status\":\"running\",\"job_id\":\"job_6666\"}" } ], "isError": false },
    "errors": [
      { "when": "token 無效或 grant 已撤銷", "error": { "code": "unauthorized", "message": "unauthorized" } },
      { "when": "同 request_id 不同參數", "error": { "code": "request_id_conflict", "message": "request_id reused with different arguments" } },
      { "when": "工具不在目前等級", "error": { "code": "tool_not_allowed", "message": "tool not allowed" } }
    ]
  },
  "http_mapping": {
    "oauth_error_body": { "error": "invalid_grant", "error_description": "invalid grant" },
    "unauthorized_mcp": { "status": 401, "www_authenticate": "Bearer resource_metadata=\"https://hands.example.com/.well-known/oauth-protected-resource\"" },
    "jsonrpc_error": { "jsonrpc": "2.0", "id": 1, "error": { "code": -32601, "message": "Method not found" } },
    "forbidden_source": { "status": 403, "body": "forbidden" },
    "not_found": { "status": 404, "body": "not found" }
  }
}
