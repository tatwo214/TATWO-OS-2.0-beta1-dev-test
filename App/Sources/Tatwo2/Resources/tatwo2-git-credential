#!/bin/sh

case "${1:-get}" in
  get|"") ;;
  *) exit 0 ;;
esac

protocol=""
host=""
requested_username=""
credential_path=""
while IFS='=' read -r key value; do
  case "$key" in
    protocol) protocol=$value ;;
    host) host=$value ;;
    username) requested_username=$value ;;
    path) credential_path=$value ;;
  esac
done

[ "$host" = "github.com" ] || exit 0

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
accounts_file=${TATWO2_GITHUB_ACCOUNTS_FILE:-"$script_dir/../github/accounts.json"}
[ -r "$accounts_file" ] || exit 0

username=$requested_username
if [ -z "$username" ]; then
  username=$(/usr/bin/osascript -l JavaScript -e '
function run(argv) {
    ObjC.import("Foundation");
    var file = argv[0], credentialPath = argv[1] || "", cwd = argv[2] || "";
    var data = $.NSData.dataWithContentsOfFile(file);
    if (!data) return "";
    var text = $.NSString.alloc.initWithDataEncoding(data, $.NSUTF8StringEncoding).js;
    var document;
    try { document = JSON.parse(text); } catch (_) { return ""; }
    var accounts = Array.isArray(document.accounts) ? document.accounts : [];
    function normalized(value) {
        if (!value) return "";
        return $(value).stringByStandardizingPath.js.replace(/\/+$/, "");
    }
    function matches(candidate, mapping) {
        candidate = normalized(candidate);
        mapping = normalized(mapping);
        return mapping && (candidate === mapping || candidate.indexOf(mapping + "/") === 0);
    }
    var best = null;
    accounts.forEach(function(account) {
        (account.folderMappings || []).forEach(function(mapping) {
            if (matches(credentialPath, mapping) || matches(cwd, mapping)) {
                var length = normalized(mapping).length;
                if (!best || length > best.length) best = { username: account.username, length: length };
            }
        });
    });
    if (best) return best.username;
    var fallback = accounts.find(function(account) { return account.isDefault === true; });
    return fallback ? fallback.username : "";
}' -- "$accounts_file" "$credential_path" "$PWD" 2>/dev/null)
fi

[ -n "$username" ] || exit 0
service=${TATWO2_GITHUB_KEYCHAIN_SERVICE:-tatwo2-github}
token=$(/usr/bin/security find-generic-password -s "$service" -a "$username" -w 2>/dev/null) || exit 0
[ -n "$token" ] || exit 0

printf 'username=%s\npassword=%s\n\n' "$username" "$token"
